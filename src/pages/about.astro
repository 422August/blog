---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, authors } from "../lib/blog-data.js";

const experienceTables = [
  {
    id: "competitions",
    title: "競賽、證照經歷",
    columns: [
      { label: "類別", className: "text-muted-foreground whitespace-nowrap" },
      { label: "名稱", className: "font-medium text-foreground" },
      { label: "名次／分數", className: "text-foreground/90 whitespace-nowrap" },
    ],
    rows: [
      ["資訊", "大學程式設計先修檢測識讀題", "4 級分"],
      ["資訊", "大學程式設計先修檢測實作題", "2 級分"],
      ["資訊", "國立成功大學高中生邀請賽", "第 47 名"],
      ["資訊", "國立陽明交大附中清華大學資工微課程", "優勝"],
      ["資訊", "Kaggle: Predicting Smartphone Addiction", "0.96 分"],
      ["資訊", "資訊學科能力競賽校內初賽", "優等"],
    ],
  },
  {
    id: "projects",
    title: "專題研究、專案",
    columns: [
      { label: "類別", className: "text-muted-foreground whitespace-nowrap" },
      { label: "專題名稱", className: "font-medium text-foreground" },
    ],
    rows: [
      ["資訊", "國立陽明交大附中返校打掃管理系統"],
      ["法政", "小論文：廢不廢？考試院與監察院於我國之存廢爭議"],
      ["資訊", "學術單字增強器"],
      ["資訊", "電腦活動監控工具"],
      ["資訊", "團購社團輔助工具"],
      ["資訊+社會", "利用NLP進行新聞立場分析"],
      ["資訊", "命令列式讀書時間紀錄工具"],
      ["資訊", "個人部落格建置與維護"],
      ["資訊", "會議記錄生成器"],
      ["資訊+社會", "立法院歷屆問政檢索系統"],
    ],
  },
];
---

<BaseLayout
  title={`關於August`}
  description={`關於 ${SITE.name}：記錄 AI、技術與未來的個人部落格。`}
  canonical="/about"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "首頁", to: "/" }, { label: "關於我" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">關於我</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">August0422</h1>
    </header>

    <div class="prose-article mt-10">
      <h2 id="who-I-am">關於我</h2>
      <p>
          我是August，目前就讀高中三年級，我特別喜歡製作有趣的小專案以及人工智慧（尤其是機器學習）的技術。
      </p>

      <h2 id="experience">經歷與事蹟</h2>
      <ul>
        <li>軟體研究社社長</li>
        <li>服裝儀容委員會學生代表</li>
        <li>部定必修資訊科技第一名</li>
        <li>初階程式設計第一名、微控制器應用第一名、進階程式設計第八名</li>
        <li>APCS 觀念 4 級分 / 實作 2 級分</li>
      </ul>

      {
        experienceTables.map((table) => (
          <>
            <h2 id={table.id}>{table.title}</h2>
            <div class="my-5 overflow-x-auto rounded-lg border border-border">
              <table class="w-full border-collapse text-left text-sm sm:text-base">
                <thead class="border-b border-border bg-muted/50 text-xs uppercase tracking-wider text-muted-foreground">
                  <tr>
                    {table.columns.map((col) => (
                      <th scope="col" class="px-4 py-3 font-medium whitespace-nowrap">
                        {col.label}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {table.rows.map((row) => (
                    <tr>
                      {row.map((cell, index) => (
                        <td class={`px-4 py-3 ${table.columns[index].className}`}>
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))
      }
    </div>

    <section class="mt-12 border-t border-border pt-10">
      <h2 class="font-serif text-2xl font-semibold">作者</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => (
            <a href={`/authors/${author.slug}`} class="group flex items-start gap-3">
              <img
                src={author.avatar}
                alt=""
                width="48"
                height="48"
                class="h-12 w-12 rounded-full"
              />
              <div>
                <div class="font-serif text-base font-semibold group-hover:text-primary">
                  {author.name}
                </div>
                <div class="mt-1 text-sm text-muted-foreground">{author.bio}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
