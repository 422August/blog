---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, authors } from "../lib/blog-data.js";

const competitionsAndCerts = [
  { category: "資訊", name: "大學程式設計先修檢測識讀題", result: "4 級分" },
  { category: "資訊", name: "大學程式設計先修檢測實作題", result: "2 級分" },
  { category: "資訊", name: "國立成功大學高中生邀請賽", result: "第 47 名" },
  { category: "資訊", name: "國立陽明交大附中清華大學資工微課程", result: "優勝" },
  { category: "資訊", name: "Kaggle: Predicting Smartphone Addiction", result: "0.96 分" },
  { category: "資訊", name: "資訊學科能力競賽校內初賽", result: "優等" },
];
---

<BaseLayout
  title={`關於August`}
  description={`關於 ${SITE.name}：記錄 AI、技術與未來的個人部落格。`}
  canonical="/about"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "首頁", to: "/" }, { label: "關於我" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">關於我</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">August0422</h1>
    </header>

    <div class="prose-article mt-10">
      <h2 id="who-I-am">關於我</h2>
      <p>
          我是August，目前就讀高中三年級，我特別喜歡製作有趣的小專案以及人工智慧（尤其是機器學習）的技術。
      </p>

      <h2 id="experience">經歷與事蹟</h2>
      <ul>
        <li>軟體研究社社長</li>
        <li>服裝儀容委員會學生代表</li>
        <li>部定必修資訊科技第一名</li>
        <li>初階程式設計第一名、微控制器應用第一名、進階程式設計第八名</li>
        <li>APCS 觀念 4 級分 / 實作 2 級分</li>
      </ul>

      <h2 id="competitions">競賽、證照經歷</h2>
      <div class="my-5 overflow-x-auto rounded-lg border border-border">
        <table class="w-full border-collapse text-left text-sm sm:text-base">
          <thead class="border-b border-border bg-muted/50 text-xs uppercase tracking-wider text-muted-foreground">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium whitespace-nowrap">類別</th>
              <th scope="col" class="px-4 py-3 font-medium">名稱</th>
              <th scope="col" class="px-4 py-3 font-medium whitespace-nowrap">名次／分數</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {
              competitionsAndCerts.map((item) => (
                <tr>
                  <td class="px-4 py-3 text-muted-foreground whitespace-nowrap">{item.category}</td>
                  <td class="px-4 py-3 font-medium text-foreground">{item.name}</td>
                  <td class="px-4 py-3 text-foreground/90 whitespace-nowrap">{item.result}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <section class="mt-12 border-t border-border pt-10">
      <h2 class="font-serif text-2xl font-semibold">作者</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => (
            <a href={`/authors/${author.slug}`} class="group flex items-start gap-3">
              <img
                src={author.avatar}
                alt=""
                width="48"
                height="48"
                class="h-12 w-12 rounded-full"
              />
              <div>
                <div class="font-serif text-base font-semibold group-hover:text-primary">
                  {author.name}
                </div>
                <div class="mt-1 text-sm text-muted-foreground">{author.bio}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
